{
  "name": "@hypnosleep/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -b",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "db:mysql:generate": "drizzle-kit generate --config=drizzle.config.mysql.ts",
    "db:mysql:migrate": "drizzle-kit migrate --config=drizzle.config.mysql.ts",
    "db:mysql:studio": "drizzle-kit studio --config=drizzle.config.mysql.ts",
    "db:pg:generate": "drizzle-kit generate --config=drizzle.config.postgres.ts",
    "db:pg:migrate": "drizzle-kit migrate --config=drizzle.config.postgres.ts",
    "db:pg:studio": "drizzle-kit studio --config=drizzle.config.postgres.ts",
    "db:generate": "npm run db:mysql:generate && npm run db:pg:generate",
    "db:migrate": "npm run db:mysql:migrate && npm run db:pg:migrate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@google/generative-ai": "^0.21.0",
    "bullmq": "^5.30.0",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.0",
    "ioredis": "^5.4.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.0",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.13.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "stripe": "^17.3.0",
    "uuid": "^11.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.0",
    "@types/passport": "^1.0.17",
    "@types/passport-github2": "^1.2.9",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/pg": "^8.11.10",
    "@types/uuid": "^10.0.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.0",
    "typescript": "~5.7.2",
    "vitest": "^2.1.0"
  }
}
