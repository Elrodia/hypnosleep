{
  "name": "@hypnosleep/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -b --noCheck",
    "start": "node dist/server.js",
    "seed:templates": "tsx scripts/seed-templates.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live-ai": "RUN_LIVE_AI=1 vitest run ai.fixtures",
    "lint": "eslint src/",
    "db:mysql:generate": "drizzle-kit generate --config=drizzle.config.mysql.ts",
    "db:mysql:migrate": "drizzle-kit migrate --config=drizzle.config.mysql.ts",
    "db:mysql:studio": "drizzle-kit studio --config=drizzle.config.mysql.ts",
    "db:pg:generate": "drizzle-kit generate --config=drizzle.config.postgres.ts",
    "db:pg:migrate": "drizzle-kit migrate --config=drizzle.config.postgres.ts",
    "db:pg:studio": "drizzle-kit studio --config=drizzle.config.postgres.ts",
    "db:generate": "npm run db:mysql:generate && npm run db:pg:generate",
    "db:migrate": "npm run db:mysql:migrate && npm run db:pg:migrate",
    "release": "npm run db:migrate && npm run start"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.1032.0",
    "@google/generative-ai": "^0.21.0",
    "@sentry/node": "^8.47.0",
    "bullmq": "^5.30.0",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "execa": "^9.6.1",
    "express": "^4.21.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.0",
    "nanoid": "^5.1.9",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0",
    "passport-microsoft": "^2.1.0",
    "pg": "^8.13.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "posthog-node": "^4.4.1",
    "stripe": "^17.3.0",
    "tsx": "^4.19.0",
    "uuid": "^11.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.0",
    "@types/passport": "^1.0.17",
    "@types/passport-github2": "^1.2.9",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/pg": "^8.11.10",
    "@types/uuid": "^10.0.0",
    "typescript": "~5.7.2",
    "vitest": "^2.1.0"
  }
}
